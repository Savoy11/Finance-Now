# Finance Now — frontend environment
#
# Copy to .env.local and fill in what you need. NOTHING here is required to
# start the app: it runs live-only against keyless public providers, and every
# surface with no reachable source says so rather than inventing a figure.
# Each variable below unlocks a specific set of surfaces — nothing more.
#
# Full reference, including which surface each key affects:
#   CLAUDE.md § Environment Variables

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres. Backs users, entitlements, portfolios, watchlists, builder plans,
# wallets and instruments. Without it those routes answer 503 (the isDbConfigured
# guard) and the rest of the app still runs.
# DATABASE_URL=postgres://user:password@localhost:5432/financenow

# ── Auth (Auth.js / next-auth v5) ─────────────────────────────────────────────
# REQUIRED once the login wall is re-enabled. Auth.js reads it straight from the
# environment, so it appears in no source file and grep will not find it.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Allows an anonymous visitor to act as a shared local user. Defaults to allowed
# in development and DENIED in production.
# ⚠ Setting this true in production hands every anonymous visitor the same
# account. See src/lib/auth/session.ts.
# FN_ALLOW_LOCAL_USER=true

# ── Optional legacy backend ───────────────────────────────────────────────────
# The dormant FastAPI backend (assets / market-data / alerts / risk-scores).
# Auth does NOT route here any more.
# Set the backend ORIGIN only — no /api or /api/v1 suffix. The Next rewrite
# appends /api/:path itself, so a suffix doubles the path.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Absolute base for share links and metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI agents ─────────────────────────────────────────────────────────────────
# Powers the Daily Brief, every agent, and the Pump Report. Also settable in
# Integrations → AI Providers, where a UI-saved key wins over this.
# ANTHROPIC_API_KEY=

# Other LLM providers resolve the same way (UI key first, then env):
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# PERPLEXITY_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# COHERE_API_KEY=

# ── Market data providers ─────────────────────────────────────────────────────
# All optional, all settable in the Integrations UI instead.
#
# FMP is the load-bearing one: first rung of the quote ladder, the only source
# for the Stock Registry universe and the market calendar, and the OHLCV
# fallback. Its FREE tier covers single-symbol quote/profile/history and the
# earnings calendar; batch quotes and the company screener are paid, so the
# broad Stock Registry universe needs a paid plan.
# FMP_API_KEY=

# COINGECKO_API_KEY=            # paid tier; COINGECKO_BASE_URL overrides the endpoint
# COINGECKO_BASE_URL=

# Equity quotes (the ladder after FMP):
# FINNHUB_API_KEY=
# TWELVE_DATA_API_KEY=
# TIINGO_API_KEY=               # also the first OHLCV rung
# ALPHA_VANTAGE_API_KEY=

# Crypto and news:
# COINMARKETCAP_API_KEY=
# BINANCE_API_KEY=
# CRYPTOPANIC_API_KEY=
# MESSARI_API_KEY=
# NEWSAPI_API_KEY=
# GNEWS_API_KEY=
# LUNARCRUSH_API_KEY=
# SANTIMENT_API_KEY=

# Reddit's robots.txt disallows this app's agent, so reddit.com is gated off in
# pinnedFetch unless this is set (terms review, 2026-08-29).
# REDDIT_CLIENT_ID=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Default true. Set false to forbid the keyless CoinGecko rung on
# /live-data/coin-profile, leaving only the keyed CoinMarketCap path.
# FN_ALLOW_KEYLESS_COIN_PROFILES=true

# Sensitive endpoints (AI agents, provider config) require this token when the
# app is served from a non-localhost host. Without it they are localhost-only.
# FN_ADMIN_TOKEN=

# Base URL the MCP server and scripts call back into.
# FN_BASE_URL=http://localhost:3000
