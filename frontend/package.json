{
  "name": "finance-now-frontend",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "smoke": "node scripts/test-live-data.mjs --quick",
    "audit": "node scripts/test-live-data.mjs",
    "audit:strict": "node scripts/test-live-data.mjs --strict",
    "audit:json": "node scripts/test-live-data.mjs --json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:status": "node scripts/db-status.mjs",
    "db:create": "node --env-file=.env.local scripts/db-create.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "restart": "npx kill-port 3000 & rmdir /s /q .next & npm run dev",
    "update": "git pull && npm install --no-audit --no-fund && npm run restart",
    "data-sources": "tsx scripts/gen-data-sources.ts",
    "terms:report": "tsx scripts/terms-report.mjs",
    "fund-facts": "node scripts/build-fund-facts.mjs",
    "fee-worksheet": "tsx scripts/gen-transfer-fee-worksheet.ts",
    "staking-worksheet": "tsx scripts/gen-staking-catalog-worksheet.ts",
    "fee-probe": "tsx scripts/probe-exchange-fee-apis.mjs",
    "gas-probe": "tsx scripts/probe-gas-rpcs.mjs",
    "rates-probe": "tsx scripts/probe-rates-scale.mjs",
    "rates-providers": "tsx scripts/probe-rates-providers.mjs",
    "staking-upstreams": "node scripts/probe-staking-upstreams.mjs",
    "discovery-upstreams": "tsx scripts/probe-discovery-upstreams.mjs",
    "llama-symbols": "node scripts/probe-llama-symbols.mjs",
    "fund-fees": "node scripts/build-fund-fees.mjs",
    "fee-reconcile": "tsx scripts/reconcile-transfer-fees.ts",
    "fee-apply": "tsx scripts/apply-fee-updates.ts",
    "fee-check-page": "tsx scripts/gen-fee-check-page.ts",
    "fee-check-plan": "tsx scripts/fee-check-plan.ts",
    "fund-prospectus-fees": "node scripts/probe-fund-prospectus-fees.mjs",
    "agent-eval": "node scripts/run-agent-eval.mjs",
    "staking:refresh-fallbacks": "node scripts/refresh-staking-fallbacks.mjs",
    "docs:check": "tsx scripts/check-doc-facts.ts",
    "queue:check": "node scripts/check-queue-ledger.mjs",
    "staleness:check": "tsx scripts/check-staleness-horizon.ts",
    "deps:check": "node scripts/check-dependency-audit.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tanstack/react-query": "^5.104.1",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.51.0",
    "next": "15.5.27",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.45.0",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.6.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "undici": "^7.29.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "js-yaml": "^5.4.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
